# Copy to .env. Everything here is optional: with no values the app runs
# locally, offline, with the rule-based assessor and no model weights.

# Where the database and the audio live. Both are gitignored.
DATA_DIR=data
RECORDINGS_DIR=recordings

# `whisper` uses faster-whisper locally (pip install -r requirements-asr.txt).
# It falls back to replaying stored transcripts when that is not installed.
TRANSCRIBER=whisper
# small.en is the floor for accented speech; base.en is unusable on it.
# See docs/whisper-grammar-fidelity.md.
WHISPER_MODEL=small.en
# Directory of <name>.json transcripts, for running with no ASR at all.
TRANSCRIPT_FIXTURES=

# `rules` (offline, default), `claude`, `both` or `none`.
ASSESSOR=rules
# Without a key nothing is sent anywhere, whatever ASSESSOR says.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5

# Conversation mode. `scripted` forces the offline partner even with a key.
REPLIER=claude
# `silent` (default), `piper` or `sapi`.
VOICE=silent
PIPER_MODEL=
SAPI_VOICE=Microsoft Zira Desktop

# The placement exam to serve. Changing this changes the baseline, which
# is the one thing that is supposed to stay still.
EXAM_VERSION=v1
